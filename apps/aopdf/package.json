{
  "name": "@axiomordo/aopdf",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack && node scripts/externalize-flight-scripts.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint app components governance lib scripts tests workers playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:reader-evidence": "node scripts/run-browser-tests.mjs --project=chromium --grep \"redaction bundle contains\"",
    "sync:csp": "node scripts/sync-csp-hashes.mjs",
    "verify:csp": "node scripts/verify-csp-hashes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "framer-motion": "12.43.0",
    "jszip": "^3.10.1",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
