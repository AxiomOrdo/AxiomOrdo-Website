# Public application URL, including the governed base path.
NEXTAUTH_URL=https://axiomordo.com/ao-pdf

# Generate a new value before enabling account routes.
NEXTAUTH_SECRET=
NEXT_PUBLIC_AOPDF_ACCOUNTS_ENABLED=false

# Issue a new PostgreSQL connection string before enabling accounts or usage.
DATABASE_URL=

# Issue new Stripe credentials before enabling paid plans.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_AOPDF_BILLING_ENABLED=false

# Use stable Stripe price identifiers rather than creating inline prices.
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
