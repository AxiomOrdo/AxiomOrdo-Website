# Commercial features remain disabled in the static production artifact.
AOPDF_COMMERCIAL_ENABLED=false
AOPDF_BILLING_ENABLED=false

# Required only in a separately reviewed server-capable artifact.
NEXTAUTH_URL=https://www.axiomordo.com/ao-pdf
NEXTAUTH_SECRET=
DATABASE_URL=

# Repository defaults intentionally provide no plans, limits, or prices.
AOPDF_DEFAULT_PLAN_CODE=
AOPDF_PLAN_ENTITLEMENTS_JSON=

# Required only when billing is separately enabled and verified.
AOPDF_APP_ORIGIN=https://www.axiomordo.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AOPDF_STRIPE_PRICE_MAP_JSON=
