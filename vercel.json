    { "source": "/aopdf/privacy/", "destination": "/aopdf/privacy/index.html" },
    { "source": "/aopdf/terms", "destination": "/aopdf/terms/index.html" },
    { "source": "/aopdf/terms/", "destination": "/aopdf/terms/index.html" },
    { "source": "/aopdf/tools", "destination": "/aopdf/tools/index.html" },
    { "source": "/aopdf/tools/", "destination": "/aopdf/tools/index.html" },
