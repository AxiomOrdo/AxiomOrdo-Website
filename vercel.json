{
  "redirects": [
    { "source": "/meriden", "destination": "/platforms/meriden", "permanent": true },
    { "source": "/meriden/", "destination": "/platforms/meriden", "permanent": true },
    { "source": "/eudr", "destination": "/sentinel", "permanent": true },
    { "source": "/clearline", "destination": "/clearmark", "permanent": true },
    { "source": "/pfas", "destination": "/clearmark", "permanent": true }
  ],
  "headers": [
    {
      "source": "/aopdf/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://vercel.live 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo='; connect-src 'self' https://vercel.live; worker-src 'self' blob:; img-src 'self' blob: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'none'; manifest-src 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/aopdf", "destination": "/aopdf/index.html" },
    { "source": "/aopdf/", "destination": "/aopdf/index.html" },
    { "source": "/aopdf/acceptable-use", "destination": "/aopdf/acceptable-use/index.html" },
    { "source": "/aopdf/acceptable-use/", "destination": "/aopdf/acceptable-use/index.html" },
